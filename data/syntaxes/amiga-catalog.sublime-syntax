%YAML 1.2
---
# Amiga locale catalogs' source, as CatComp's documentation (in the NDK) and FlexCat's describe it: catalog
# descriptions (.cd), with # commands and NAME (id/min/max) lines, and catalog translations (.ct), with ## commands
# and names alone. The line after a name is its string, with its escapes (\n, \e, \c, \x9B) and % formatting
# commands; a string line ending with a backslash carries on on the next. Lines starting ; are comments.
name: Amiga catalog (.cd and .ct)
file_extensions: ["cd", "ct"]
scope: source.amiga-catalog
contexts:
  main:
    - match: '^\s*;.*$'
      scope: comment.line.amiga-catalog
    - match: '^\s*(##?)\s*(\w+)(.*)$'
      captures:
        1: punctuation.definition.keyword.amiga-catalog
        2: keyword.control.amiga-catalog
        3: string.unquoted.amiga-catalog
    - match: '^\s*([A-Za-z_]\w*)\s*(\()([^)]*)(\))\s*$\n?'
      captures:
        1: entity.name.constant.amiga-catalog
        2: punctuation.section.parens.amiga-catalog
        3: constant.numeric.amiga-catalog
        4: punctuation.section.parens.amiga-catalog
      push: string
    - match: '^\s*([A-Za-z_]\w*)\s*$\n?'
      captures:
        1: entity.name.constant.amiga-catalog
      push: string
  # The line after a name is its string, all of it, even if it starts with a semicolon: this waits for that
  # line to start.
  string:
    - match: '^'
      set: string_line
  string_line:
    - meta_scope: string.unquoted.amiga-catalog
    # A string ending with a backslash carries on on the next line.
    - match: '\\$\n?'
      scope: punctuation.separator.continuation.amiga-catalog
      set: string
    - match: '\\(?:[xX][0-9A-Fa-f]{1,2}|[0-7]{1,3}|.)'
      scope: constant.character.escape.amiga-catalog
    - match: '%%|%(?:\d+\$)?[-+ #0]*(?:\d+|\*)?(?:\.\d+)?[lhL]*[bcdeEfgGiopsuxXNTDU]'
      scope: constant.other.placeholder.amiga-catalog
    - match: '$\n?'
      pop: true
