# Assembler sources built into the program or its tests stay with plain line ends on every system, as the starters
# are offered and the tests compare them that way (Git on Windows would otherwise check them out with CR LF).
src/**/*.s   text eol=lf
src/**/*.asm text eol=lf
src/**/*.a   text eol=lf

# Test files compared byte for byte (crunched files and the originals they were crunched from, CharPad projects):
# never given CR LF line ends on Windows.
src/**/testdata/** -text
src/tile_testdata/** -text

# Jupyter notebooks used to test reading and saving byte for byte: never given CR LF line ends on Windows.
src/notebook_testdata/** -text

# Spreadsheets and JSON-lines files used to test the data viewer: never given CR LF line ends on Windows.
src/data_testdata/** -text

# The code Limoniter runs on a notebook's kernel to list its variables.
src/kernel_code/** -text
