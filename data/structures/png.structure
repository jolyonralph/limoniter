# PNG pictures: the signature, then chunks, each with its length, its name, its data and a CRC of the name and
# data (the PNG specification, third edition).
name "PNG picture"
magic str(0, 8) == "\x89PNG\r\n\x1A\n"
order big

enum ColourType : u8 {
    greyscale = 0
    truecolour = 2 "Red, green and blue"
    indexed = 3 "Colours from a palette"
    greyscale_alpha = 4
    truecolour_alpha = 6
}

enum Unit : u8 {
    unknown = 0
    metre = 1
}

struct Colour {
    u8 red
    u8 green
    u8 blue
    label red * 65536 + green * 256 + blue
}

struct Chunk {
    u32 length
    char type[4] "Lower case first letter: a chunk that may be left out. Lower case second: private"
    label type
    if type == "IHDR" {
        u32 width
        u32 height
        u8 bit_depth
        ColourType colour_type
        u8 compression "Always 0: deflate"
        u8 filter
        u8 interlace "1 for Adam7"
    } else if type == "PLTE" {
        Colour palette[length / 3]
    } else if type == "tEXt" || type == "iTXt" || type == "zTXt" {
        cstring keyword
        u8 text[length - len(keyword) - 1]
    } else if type == "tIME" {
        u16 year
        u8 month
        u8 day
        u8 hour
        u8 minute
        u8 second
    } else if type == "pHYs" {
        u32 x_pixels_per_unit
        u32 y_pixels_per_unit
        Unit unit
    } else if type == "gAMA" {
        u32 gamma "Times 100000"
    } else if type == "acTL" {
        u32 frames
        u32 plays "0 for for ever"
    } else {
        u8 data[length]
    }
    goto start_of(type) + 4 + length
    u32 crc : hex
    check crc == crc32(start_of(type), length + 4) "The CRC doesn't match the chunk"
}

u8 signature[8]
Chunk chunks[while here + 12 <= file_size]
