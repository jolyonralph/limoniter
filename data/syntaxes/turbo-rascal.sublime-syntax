      scope: support.function.turborascal
    - match: '(?<![\w.$])(?:\$[0-9A-Fa-f]+|%[01]+|\d+(?:\.\d+)?)'
      scope: constant.numeric.turborascal
    - match: ':=|[-+*/=<>]'
      scope: keyword.operator.turborascal
  block_comment:
    - meta_scope: comment.block.turborascal
    - match: '\*/'
      pop: true
  brace_comment:
    - meta_scope: comment.block.turborascal
    - match: '\}'
      pop: true
  string_double:
    - meta_scope: string.quoted.double.turborascal
    - match: '"'
      pop: true
    - match: '(?=\n)'
      pop: true
  string_single:
    - meta_scope: string.quoted.single.turborascal
    - match: "'"
      pop: true
    - match: '(?=\n)'
      pop: true
