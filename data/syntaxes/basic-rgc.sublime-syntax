%YAML 1.2
---
# RGC BASIC, Retro Game Coders' modern BASIC: Commodore BASIC's ways (line numbers if wanted, POKE and PEEK) with
# structured blocks (IF ... END IF, WHILE ... WEND, DO ... LOOP, FUNCTION ... END FUNCTION), and its own words for
# sprites, sound and music, the screen and drawing. REM and ' comments; " strings with \ escapes.
name: BASIC (RGC BASIC)
file_extensions: ["rgcbas"]
scope: source.basic.rgc
contexts:
  main:
    - match: '^\s*\d+'
      scope: constant.numeric.line-number.basic.rgc
    - match: "(?i)(?:'|\\bREM\\b).*$"
      scope: comment.line.basic.rgc
    - match: '"'
      push: string
    - match: '(?i)\b(FUNCTION)\s+([A-Za-z_]\w*)'
      captures:
        1: keyword.declaration.basic.rgc
        2: entity.name.function.basic.rgc
    - match: '(?i)(?<![A-Za-z0-9_$])(?:ISMOUSEBUTTONPRESSED|ISMOUSEOVERSPRITE|MUSICSAMPLECOUNT|MUSICSAMPLENAME\$|MUSICCHANNELS|MUSICPATTERNS|SPRITECOLLIDE|MUSICPLAYING|SOUNDPLAYING|BUFFERPATH\$|LASTINDEXOF|MUSICLENGTH|MUSICORDERS|MUSICTITLE\$|PALETTEHEX\$|SPRITETILES|FILEEXISTS|HTTPSTATUS|ANIMFRAME|BUFFERLEN|MUSICPEAK|MUSICTIME|PLATFORM\$|JOYSTICK|JSONKEY\$|KEYPRESS|SPRITEAT|INDEXOF|JOYAXIS|JSONLEN|KEYDOWN|PALETTE|REPLACE|SCROLLX|SCROLLY|SPRITEH|SPRITEW|STRING\$|FIELD\$|INKEY\$|LCASE\$|LTRIM\$|RIGHT\$|RTRIM\$|SYSTEM|TICKMS|TICKUS|UCASE\$|EXEC\$|HTTP\$|INSTR|JSON\$|KEYUP|LEFT\$|TRIM\$|ARG\$|ARGC|CHR\$|CWD\$|DIR\$|ENV\$|EVAL|HEX\$|HTTP|MID\$|PEEK|STR\$|ABS|ASC|COS|DEC|EXP|INT|JOY|LEN|LOG|RND|SGN|SIN|SPC|SQR|TAB|TAN|VAL|ST|TI)(?![A-Za-z0-9_$])'
      scope: support.function.basic.rgc
    - match: '(?i)(?<![A-Za-z0-9_$])(?:DRAWSPRITETILE|SPRITEMODULATE|PALETTEROTATE|PALETTESETHEX|SPRITEVISIBLE|DOUBLEBUFFER|FILLTRIANGLE|PALETTERESET|UNLOADSPRITE|BITMAPCLEAR|BUFFERFETCH|DRAWTILEMAP|FILLELLIPSE|FILLPOLYGON|MUSICVOLUME|PALETTELOAD|PALETTESAVE|RESUMEMUSIC|SCREENCODES|SPRITEFRAME|SPRITESTAMP|UNLOADMUSIC|UNLOADSOUND|BACKGROUND|BUFFERFREE|DRAWSPRITE|FILLCIRCLE|LOADSCREEN|LOADSPRITE|PALETTESET|PAUSEMUSIC|SPRITECOPY|ANTIALIAS|BUFFERNEW|FLOODFILL|HTTPFETCH|LOADMUSIC|LOADSOUND|MUSICLOOP|PLAYMUSIC|PLAYSOUND|STOPMUSIC|STOPSOUND|DOWNLOAD|DRAWTEXT|FILLRECT|FUNCTION|TRIANGLE|ELLIPSE|FOREACH|GETBYTE|MAPLOAD|MAPSAVE|OBJLOAD|OBJSAVE|OVERLAY|POLYGON|PUTBYTE|RESTORE|TILEMAP|BUFFER|CIRCLE|COLOUR|CREATE|CURSOR|ELSEIF|LOCATE|MEMCPY|MEMSET|PRESET|RETURN|SCREEN|SCROLL|SPRITE|TEXTAT|BLEND|CHDIR|CLEAR|CLOSE|COLOR|FRAME|GOSUB|IMAGE|INPUT|PAPER|PRINT|RESET|SLEEP|SPLIT|STAMP|TIMER|UNTIL|VSYNC|WHILE|COPY|DATA|DRAW|ELSE|EXIT|FREE|GOTO|GRAB|JOIN|LINE|LOAD|LOOP|NEXT|OPEN|POKE|PSET|READ|RECT|SAVE|SHOW|SORT|STEP|STOP|SWAP|THEN|TILE|WEND|ZONE|AND|CLS|DEF|DIM|DIR|END|FOR|GET|LET|NEW|NOT|DO|IF|IN|ON|OR|TO)(?![A-Za-z0-9_$])'
      scope: keyword.control.basic.rgc
    - match: '(?<![\w.$])\d+(?:\.\d+)?(?:[eE][-+]?\d+)?'
      scope: constant.numeric.basic.rgc
    - match: '\+=|-=|\*=|/=|\+\+|--|<=|>=|<>|[-+*/^=<>]'
      scope: keyword.operator.basic.rgc
  string:
    - meta_scope: string.quoted.double.basic.rgc
    - match: '\\.'
      scope: constant.character.escape.basic.rgc
    - match: '"'
      pop: true
    - match: '(?=\n)'
      pop: true
