<?xml version="1.0" encoding="utf-8"?>
<!-- Limoniter's package for the Microsoft Store. make-msix.ps1 fills in the {{...}} values: the identity and
     publisher are the ones Partner Center gives when the name is reserved, and the version comes from Cargo.toml. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Limoniter</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A text and hex editor for everyday work, and for the files of older computers.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-gb" />
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Limoniter" Executable="limoniter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Limoniter"
        Description="A text and hex editor for everyday work, and for the files of older computers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
{{FILE_TYPES}}
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
